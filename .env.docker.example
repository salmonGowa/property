# Copy to .env.docker and fill in. Never commit .env.docker or share it.
APP_NAME="UPMS"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=upms
DB_USERNAME=upms
DB_PASSWORD=change-me

# Used by the MySQL container to create the database; keep in step with DB_* above.
MYSQL_DATABASE=upms
MYSQL_USER=upms
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Set to * when running behind a load balancer or ingress that terminates HTTPS.
TRUSTED_PROXIES=

MPESA_CALLBACK_TOKEN=
MPESA_SHORTCODE=
